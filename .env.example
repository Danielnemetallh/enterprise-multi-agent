# Interview mode: runs the complete workflow locally without network access.
SUPPORTFLOW_DEMO_MODE=true

# Live mode: set SUPPORTFLOW_DEMO_MODE=false and configure an OpenAI-compatible provider.
LLM_PROVIDER=your-provider-name
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-name

# Existing DEEPSEEK_* variables remain supported as legacy aliases.
